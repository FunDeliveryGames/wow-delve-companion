package-as: DelveCompanion
ignore:
  - .vscode #folder
  - .git #folder
  - .github #folder
  - .claude #folder
  - Releases #folder
  - Release Notes #folder
  - Tests #folder
  - .gitignore
  - README.md
  - LICENSE
  - CHANGELOG.md
